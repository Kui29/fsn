NEXT_EMAILJS_SERVICEID=your-emailjs-service-id
NEXT_EMAILJS_TEMPLATEID=your-emailjs-template-id
NEXT_EMAILJS_PUBLICKEY=your-emailjs-public-key

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Comma-separated Google account emails allowed into /admin
ADMIN_EMAILS=admin@example.com,another.admin@example.com

# Firebase service account key JSON on one line (Firebase console → Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key":"...","client_email":"..."}
